<?xml version="1.0"?>
<!--
    BlueROV2 Heavy demonstration scenario.

    A shallow-water scene with a seabed and a few reference objects, used by BlueROV2Test.
    The vehicle itself is defined in bluerov2_heavy.scn and included at the bottom of this
    file, so it can be reused in other scenarios without copying anything.
-->
<scenario>
	<solver>
		<multithreading max_physics_threads="8"/>
	</solver>

	<environment>
		<ned latitude="69.68" longitude="18.94"/>

		<ocean>
			<water density="1000.0" jerlov="0.15"/>
			<waves height="0.2"/>
			<current type="uniform">
				<velocity xyz="0.1 0.0 0.0"/>
			</current>
		</ocean>

		<atmosphere>
			<sun azimuth="150.0" elevation="45.0"/>
		</atmosphere>
	</environment>

	<materials>
		<material name="Neutral" density="1000.0" restitution="0.5"/>
		<material name="Rock" density="3000.0" restitution="0.8"/>
		<material name="Aluminium" density="2710.0" restitution="0.7"/>
		<material name="Lead" density="11340.0" restitution="0.3"/>
		<friction_table>
			<friction material1="Neutral" material2="Neutral" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Rock" static="0.2" dynamic="0.1"/>
			<friction material1="Neutral" material2="Aluminium" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Lead" static="0.5" dynamic="0.2"/>
			<friction material1="Rock" material2="Rock" static="0.9" dynamic="0.7"/>
			<friction material1="Rock" material2="Aluminium" static="0.6" dynamic="0.3"/>
			<friction material1="Rock" material2="Lead" static="0.6" dynamic="0.3"/>
			<friction material1="Aluminium" material2="Aluminium" static="0.8" dynamic="0.5"/>
			<friction material1="Aluminium" material2="Lead" static="0.6" dynamic="0.3"/>
			<friction material1="Lead" material2="Lead" static="0.6" dynamic="0.3"/>
		</friction_table>
	</materials>

	<looks>
		<look name="seabed" rgb="0.7 0.7 0.5" roughness="0.9"/>
		<look name="marker" rgb="1.0 0.1 0.0" roughness="0.4"/>
		<look name="concrete" gray="0.6" roughness="0.9"/>
	</looks>

	<static name="Seabed" type="plane">
		<material name="Rock"/>
		<look name="seabed" uv_scale="2.0"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 12.0"/>
	</static>

	<!-- Reference objects, so the camera and DVL have something to look at -->
	<static name="Block1" type="box">
		<dimensions xyz="1.0 1.0 1.0"/>
		<material name="Rock"/>
		<look name="concrete"/>
		<world_transform rpy="0.0 0.0 0.4" xyz="4.0 1.5 11.5"/>
	</static>

	<static name="Block2" type="box">
		<dimensions xyz="2.0 0.5 0.5"/>
		<material name="Rock"/>
		<look name="concrete"/>
		<world_transform rpy="0.0 0.0 -0.2" xyz="6.0 -2.0 11.75"/>
	</static>

	<dynamic name="Marker" type="sphere" physics="submerged" buoyant="true">
		<dimensions radius="0.25"/>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		<material name="Neutral"/>
		<look name="marker"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="3.0 0.0 2.0"/>
	</dynamic>

	<include file="bluerov2_heavy.scn">
		<arg name="robot_name" value="BLUEROV2"/>
		<arg name="robot_position" value="0.0 0.0 3.0"/>
		<arg name="dvl_up" value="0"/>
	</include>
</scenario>
